{
  "manifest_version": 3,
  "name": "EasyImageSave",
  "version": "1.0.2",
  "description": "Save images in JPG, PNG, or WEBP format easily.",
  "permissions": [
      "contextMenus",
      "downloads",
      "activeTab",
      "offscreen",
      "notifications",
      "clipboardWrite",
      "storage",
      "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/background/offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "public/easeimagesave-icon-16.png",
    "48": "public/easeimagesave-icon-48.png",
    "128": "public/easeimagesave-icon-128.png"
  }
}
